# For LOCAL DEVELOPMENT: leave this file alone / don't create a .env from it.
# The Vite dev server proxies /api and /uploads to http://localhost:4000 automatically
# (see vite.config.js), so nothing needs to be set here while developing on your laptop.

# For DEPLOYMENT ONLY: once the backend is deployed separately (e.g. on Render), copy
# this file to .env.production and set this to your backend's real URL, no trailing slash.
# Example: VITE_API_BASE_URL=https://radio-light-and-life-api.onrender.com
VITE_API_BASE_URL=
