# Copy this file to .env and fill in your real values

PORT=4000

# Your live stream URL from your streaming host (Shoutcast/Icecast/Zeno FM/Radio.co/etc).
# Leave blank until you have one -- the player will show "Stream offline" until it's set.
STREAM_URL=

# Optional: a JSON "now playing" metadata URL some hosts provide (Zeno FM, Radio.co, Azuracast).
# If left blank, the site falls back to the schedule table to show what's "on air" right now.
STREAM_METADATA_URL=

STATION_NAME=Radio Light and Life
STATION_FREQUENCY=107.3 FM
STATION_TAGLINE=Changing Lives
STATION_CITY=Kericho, Kenya

# Email delivery for the contact form (optional). If left blank, messages are still
# saved to the database and visible via GET /api/contact (protect this route before going live).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVING_EMAIL=

# Admin panel login (used to add/edit presenters, schedule, and news from the website itself).
# Change these before deploying anywhere public.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
JWT_SECRET=please-change-this-to-a-long-random-string
